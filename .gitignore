.venv/
.venvs/
__pycache__/
.pytest_cache/
dist/
*.egg-info/
# Raw output of the converters in spike 2. convert.py makes it again.
spike/*/verify/convert/*/raw/
*.py[cod]
# A project of datasheet-lens in the root of this repository, for development
# tests. The datasheets are third-party documents.
/datasheet-lens.toml
/datasheets/
# Files that the user gives for a task (for example datasheets to add).
/tmp/
# Generated binary outputs of the spikes (images, caches, PDF extracts, element
# maps). The scripts of the spikes make them again. The text results are in git.
spike/*/subset/cache*/
spike/*/subset/llm/*.png
spike/*/subset/pdf/
spike/nrf54lm20/lens/elements.json
spike/*/verify/convert/*/img/
